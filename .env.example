# ---------------------------------------------------------------------------
# DealAssistant configuration
#
# Copy this file to .env and fill in your own values.
# Everything here is read at startup, so restart the app after editing.
#
# Your Discord application must have User Install enabled with the
# applications.commands scope. See the README for the full setup steps.
# ---------------------------------------------------------------------------

# === Required ==============================================================

# Bot token for your Discord application.
# Developer Portal -> your application -> Bot -> Reset Token -> Copy.
# Treat this like a password: anyone holding it controls your application.
DISCORD_TOKEN=

# Application ID.
# Developer Portal -> your application -> General Information -> Application ID.
DISCORD_CLIENT_ID=

# Your own Discord user ID. This is NOT the application ID.
# Only this account may run commands; with the wrong value every command is
# refused, which is the most common setup mistake.
# How to copy it: Discord User Settings -> Advanced -> enable Developer Mode,
# then right-click your own name -> Copy User ID.
DISCORD_OWNER_ID=

# === Appearance (optional) =================================================

# Name shown in embeds and help text.
DISPLAY_NAME=Deal Assistant

# Embed accent colour as a hex value.
EMBED_COLOR="#5865F2"

# Footer text added to every embed. Leave blank for no footer.
EMBED_FOOTER=

# === Payment addresses (optional) ==========================================
# A payment command is only registered when its address is set.
# Leave unused addresses blank to disable those commands.
# Only public receiving addresses belong here - never a seed phrase or key.
#
# Each address is validated for its network when the app starts; an invalid
# value stops startup with an error naming the variable. Addresses are never
# corrected or rewritten. See the README for the accepted formats.

BTC_ADDRESS=
LTC_ADDRESS=
ETH_ADDRESS=
SOL_ADDRESS=
USDC_ETH_ADDRESS=
USDC_SOL_ADDRESS=

# Cash App tag, with or without the leading $. Leave blank to disable /cashapp.
CASHAPP_TAG=

# Set true to make the optional qr:true argument available for crypto payments.
PAYMENT_QR_ENABLED=false

# === Contact links (optional) ==============================================
# Full URLs including https://. Unset links are left out of /info.

TELEGRAM_URL=
WEBSITE_URL=
EMAIL_ADDRESS=
MARKETPLACE_PROFILE_URL=
VOUCH_THREAD_URL=

# === Command selection (optional) ==========================================
# Comma-separated commands to enable. Leave blank to enable every command
# that has the configuration it needs.
# Available: btc, ltc, eth, sol, usdceth, usdcsol, cashapp, info, vouch, middleman, pay, price, convert, help
ENABLED_COMMANDS=
